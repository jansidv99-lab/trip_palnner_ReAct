# Phase 0 – Step 4: template for .env (copy to .env and fill in; .env is git-ignored)

# Required
OPENAI_API_KEY="your-api-key"

# Optional – OpenAI-compatible endpoint (leave empty for api.openai.com)
OPENAI_BASE_URL=""
# Optional – default model (default: gpt-4o-mini)
MODEL="gpt-4o-mini"
# Optional – itinerary prompt version, maps to prompts/itinerary/<version>.md (default: v1)
PROMPT_VERSION="v1"
# Phase 12 – Step 3: optional – where the Streamlit app logs agent runs
# (unset: logs/agent_runs.jsonl; "off" disables it)
# AGENTSVILLE_RUN_LOG="off"
# Phase 12 – Step 6: optional – where the app stores traveler feedback
# (unset: logs/feedback.jsonl; "off" disables it)
# AGENTSVILLE_FEEDBACK_LOG="off"
# Phase 13 – Step 3: optional – set to require a passcode before the app shows anything
# (on Cloud Run it comes from Secret Manager; leave unset for local development)
# APP_PASSCODE=""

# Needed for deployment (Phase 13 – see plan/13-cd/gcp-setup.md)
GCP_PROJECT_ID="your-project-id"
GCP_PROJECT_NUMBER="000000000000"
REGION="asia-south1"
GIT_REPO="https://github.com/<owner>/<repo>"
